# Vorlage für die lokale Entwicklung. Diese Datei enthält keine echten
# Geheimnisse und gehört ins Repository; eine Kopie als `.env` mit den
# wirklichen Werten gehört NICHT hinein (siehe .gitignore).
#
# Im Betrieb werden dieselben Namen im Cloudflare-Dashboard hinterlegt:
# Pages-Projekt → Settings → Environment variables.

# --- Google-Bewertungen (Abruf beim Bauen der Seite) ------------------------
# Schlüssel aus der Google Cloud Console. Die "Places API (New)" muss für das
# Projekt aktiviert sein. Den Schlüssel auf diese eine API einschränken.
GOOGLE_PLACES_API_KEY=

# Kennung des Unternehmensprofils. Zu finden über die Place-ID-Suche von
# Google oder im Google-Unternehmensprofil. Beginnt üblicherweise mit "ChIJ".
GOOGLE_PLACE_ID=

# --- Anfrageformular mit Anhängen (derzeit zurückgestellt) ------------------
# Schlüssel des Versanddienstes resend.com
RESEND_API_KEY=
# Empfangspostfach für Projektanfragen
ANFRAGE_AN=
# Absenderadresse einer bei Resend verifizierten Domain
ANFRAGE_VON=
