---
import BaseLayout from './BaseLayout.astro';
import { legalLastUpdated } from '../config';

interface Props {
  title: string;
  description: string;
  /** Überschrift der Seite; fällt auf den Titel zurück. */
  heading?: string;
}

const { title, description, heading } = Astro.props;
const pageHeading = heading ?? title;
---

<BaseLayout title={title} description={description}>
  <div class="legal-page">
    <div class="wrap">
      <nav class="legal-breadcrumb" aria-label="Brotkrumennavigation">
        <a href="/">Startseite</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{pageHeading}</span>
      </nav>

      <h1>{pageHeading}</h1>
      <p class="legal-updated">Stand: {legalLastUpdated}</p>

      <div class="legal-prose">
        <slot />
      </div>
    </div>
  </div>
</BaseLayout>
