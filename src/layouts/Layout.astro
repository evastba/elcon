---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'ELCON Connected Building Engineering',
  description = 'Generalunternehmer für technische Gebäudeausrüstung: Elektro-, Heizungs-, Klima-, Lüftungs-, Sanitär- und Automatisierungstechnik aus einer Hand.',
} = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/assets/logo-icon.png" />
    <!-- Schriften werden selbst gehostet (siehe public/fonts und die
         @font-face-Regeln in src/styles/global.css). Dadurch entsteht beim
         Seitenaufruf keine Verbindung zu Google-Servern. Vorgeladen wird nur
         das latin-Subset, das den sichtbaren Text der Seite abdeckt. -->
    <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
