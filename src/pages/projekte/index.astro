<script>
  import { trackEvent } from '../../scripts/track';

  /* Filterleiste der Projektübersicht */
  /* Kennzahlen zählen beim Erscheinen hoch.

     Der Endwert steht im Markup, die Animation überschreibt ihn nur
     vorübergehend — ohne JavaScript oder bei abgebrochenem Skript bleibt die
     richtige Zahl stehen. Bei reduzierter Bewegung im Betriebssystem wird gar
     nicht animiert, die Zahl steht sofort. Die Jahreszahl 1993 und die Angabe
     "Alle" sind bewusst ausgenommen: Eine hochzählende Jahreszahl wirkt wie
     ein Fehler. */
  (function(){
    var felder = document.querySelectorAll('[data-zaehler]');
    if(!felder.length) return;

    var reduziert = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if(reduziert || !('IntersectionObserver' in window)) return;

    function zaehle(el){
      var ziel = parseInt(el.dataset.zaehler, 10);
      var suffix = el.dataset.suffix || '';
      if(isNaN(ziel)) return;
      var dauer = 1100;
      var start = null;

      function schritt(zeit){
        if(start === null) start = zeit;
        var anteil = Math.min((zeit - start) / dauer, 1);
        /* ease-out: schnell anlaufen, sanft auslaufen */
        var wert = Math.round(ziel * (1 - Math.pow(1 - anteil, 3)));
        el.textContent = wert + (anteil === 1 ? suffix : '');
        if(anteil < 1) requestAnimationFrame(schritt);
      }
      el.textContent = '0';
      requestAnimationFrame(schritt);
    }

    var beobachter = new IntersectionObserver(function(eintraege){
      eintraege.forEach(function(e){
        if(!e.isIntersecting) return;
        beobachter.unobserve(e.target);
        zaehle(e.target);
      });
    }, { threshold: 0.6 });

    felder.forEach(function(el){ beobachter.observe(el); });
  })();

  /* Projektraster: zunächst nur die erste Reihe zeigen.

     Wie viele Kacheln eine Reihe fasst, hängt von der Fensterbreite ab (sechs,
     vier oder zwei Spalten). Statt eine feste Zahl anzunehmen, wird die erste
     Reihe am Layout abgelesen: Alle Kacheln mit demselben oberen Abstand wie
     die erste gehören dazu. Das stimmt damit auch nach einem Filterwechsel und
     nach Größenänderung des Fensters.

     Ohne JavaScript bleiben alle Kacheln sichtbar — eingeklappt wird erst,
     wenn dieser Code läuft. */
  var rasterOffen = false;

  function aktualisiereRaster(){
    var grid = document.getElementById('projectGrid');
    var knopf = document.getElementById('projekteMehr');
    if(!grid || !knopf) return;

    var karten = Array.prototype.slice.call(grid.querySelectorAll('.project-card'));
    karten.forEach(function(k){ k.classList.remove('is-eingeklappt'); });

    var sichtbar = karten.filter(function(k){ return !k.hidden; });
    if(sichtbar.length === 0){ knopf.hidden = true; return; }

    if(rasterOffen){
      knopf.hidden = false;
      knopf.setAttribute('aria-expanded', 'true');
      knopf.textContent = 'Weniger anzeigen';
      return;
    }

    /* Erst alle Abstände messen, dann ausblenden. Würde beides im selben
       Durchlauf geschehen, verschöbe jedes ausgeblendete Element das Layout
       der nachfolgenden und deren gemessener Abstand wäre falsch. */
    var abstaende = sichtbar.map(function(k){ return k.offsetTop; });
    var ersteReihe = abstaende[0];
    var verborgen = 0;
    sichtbar.forEach(function(k, i){
      if(abstaende[i] > ersteReihe){ k.classList.add('is-eingeklappt'); verborgen++; }
    });

    knopf.hidden = verborgen === 0;
    knopf.setAttribute('aria-expanded', 'false');
    knopf.textContent = verborgen === 1
      ? 'Ein weiteres Projekt anzeigen'
      : 'Weitere ' + verborgen + ' Projekte anzeigen';
  }

  (function(){
    var knopf = document.getElementById('projekteMehr');
    if(!knopf) return;

    knopf.addEventListener('click', function(){
      rasterOffen = !rasterOffen;
      aktualisiereRaster();
      trackEvent('projekte_aufgeklappt', { offen: rasterOffen });
      if(!rasterOffen){
        document.getElementById('projectGrid').scrollIntoView({ block: 'start', behavior: 'smooth' });
      }
    });

    var timer;
    window.addEventListener('resize', function(){
      clearTimeout(timer);
      timer = setTimeout(aktualisiereRaster, 150);
    });

    aktualisiereRaster();
    /* Nach dem Laden der Schriften und Bilder können sich Höhen verschieben —
       einmal nachmessen, damit die Reihengrenze stimmt. */
    window.addEventListener('load', aktualisiereRaster);
  })();


  /* Testimonial carousel + lightbox */
  (function(){
    var track = document.getElementById('tcTrack');
    var prevBtn = document.getElementById('tcPrev');
    var nextBtn = document.getElementById('tcNext');
    if(!track) return;

    var thumbs = Array.prototype.slice.call(track.querySelectorAll('.tc-thumb'));
    var lightbox = document.getElementById('tcLightbox');
    var lbImg = document.getElementById('tcLbImg');
    var lbCaption = document.getElementById('tcLbCaption');
    var lbClose = document.getElementById('tcLbClose');
    var lbPrev = document.getElementById('tcLbPrev');
    var lbNext = document.getElementById('tcLbNext');
    var currentIndex = 0;
    var lastFocused = null;

    var dots = document.getElementById('tcDots');
    var stand = document.getElementById('tcStatus');

    function abstand(){
      var stil = getComputedStyle(track);
      return parseFloat(stil.columnGap || stil.gap || 0) || 0;
    }
    function schrittweite(){
      var slide = track.querySelector('.tc-slide');
      if(!slide) return 200;
      return slide.getBoundingClientRect().width + abstand();
    }

    /* Geblättert wird seitenweise, nicht um eine feste Zahl Kacheln: Wie viele
       nebeneinander passen, hängt von der Fensterbreite ab. Statt eine Zahl
       anzunehmen, wird sie hier ausgerechnet — dieselbe Überlegung wie beim
       Projektraster weiter oben.

       Die Kacheln teilen sich die Breite anschließend genau auf (siehe die
       Regel zu --tc-spalten in global.css). Ohne das endete eine Seite mitten
       in einer angeschnittenen Kachel, was dem Begriff "Seite" widerspricht. */
    function passeSpaltenAn(){
      var stil = getComputedStyle(track);
      var basis = parseFloat(stil.getPropertyValue('--tc-basis')) || 180;
      var l = abstand();
      var innen = track.clientWidth - parseFloat(stil.paddingLeft || 0) - parseFloat(stil.paddingRight || 0);
      var spalten = Math.max(1, Math.min(thumbs.length, Math.floor((innen + l) / (basis + l))));
      if(track.dataset.spalten === String(spalten)) return false;

      /* Beim Wechsel der Spaltenzahl soll das zuerst sichtbare Schreiben
         sichtbar bleiben, statt dass das Band an den Anfang zurückspringt. */
      var ersteKachel = Math.round(track.scrollLeft / schrittweite());
      track.style.setProperty('--tc-spalten', String(spalten));
      track.dataset.spalten = String(spalten);
      track.scrollTo({ left: Math.floor(ersteKachel / spalten) * spalten * schrittweite(), behavior: 'auto' });
      return true;
    }

    function proSeite(){
      return Number(track.dataset.spalten) || Math.max(1, Math.floor((track.clientWidth + 2) / schrittweite()));
    }
    function seitenAnzahl(){
      return Math.max(1, Math.ceil(thumbs.length / proSeite()));
    }
    function seitenbreite(){
      return proSeite() * schrittweite();
    }
    function aktuelleSeite(){
      var rest = track.scrollWidth - track.clientWidth;
      if(rest <= 2) return 0;
      /* Die letzte Seite ist meist nur teilweise gefüllt; der Bildlauf bleibt
         dann vor ihrem rechnerischen Anfang stehen. Wer ganz rechts angekommen
         ist, ist auf der letzten Seite — unabhängig vom errechneten Wert. */
      if(track.scrollLeft >= rest - 4) return seitenAnzahl() - 1;
      return Math.min(seitenAnzahl() - 1, Math.round(track.scrollLeft / seitenbreite()));
    }
    function zeigeSeite(n){
      track.scrollTo({ left: n * seitenbreite(), behavior: 'smooth' });
    }

    function machPunkt(i){
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'tc-dot';
      b.setAttribute('aria-label', (dots.dataset.punktVorlage || '{seite}').replace('{seite}', String(i + 1)));
      b.addEventListener('click', function(){ zeigeSeite(i); });
      return b;
    }

    /* Die Punkte werden erst hier erzeugt: Ihre Zahl ergibt sich aus dem
       Layout und ändert sich mit der Fensterbreite. Im Markup stehen sie
       deshalb verborgen — ohne JavaScript bleibt das Band schlicht scrollbar,
       statt eine Steuerung anzubieten, die nichts tut. */
    function bauePunkte(){
      var anzahl = seitenAnzahl();
      if(dots.childElementCount === anzahl) return;
      dots.textContent = '';
      for(var i = 0; i < anzahl; i++) dots.appendChild(machPunkt(i));
    }

    function aktualisiereSteuerung(){
      if(!dots || !stand) return;
      passeSpaltenAn();
      bauePunkte();
      var n = aktuelleSeite();
      var gesamt = seitenAnzahl();
      Array.prototype.forEach.call(dots.children, function(b, i){
        if(i === n) b.setAttribute('aria-current', 'true');
        else b.removeAttribute('aria-current');
      });
      if(prevBtn) prevBtn.disabled = n === 0;
      if(nextBtn) nextBtn.disabled = n >= gesamt - 1;
      dots.hidden = gesamt <= 1;
      stand.hidden = gesamt <= 1;
      stand.textContent = (stand.dataset.vorlage || '')
        .replace('{seite}', String(n + 1))
        .replace('{gesamt}', String(gesamt));
    }

    if(prevBtn) prevBtn.addEventListener('click', function(){ zeigeSeite(Math.max(0, aktuelleSeite() - 1)); });
    if(nextBtn) nextBtn.addEventListener('click', function(){ zeigeSeite(Math.min(seitenAnzahl() - 1, aktuelleSeite() + 1)); });

    /* Wischen auf dem Telefon und Scrollen mit der Tastatur bewegen das Band
       ebenfalls — die Anzeige muss dem folgen, nicht nur den Pfeilen. */
    var wartet = false;
    track.addEventListener('scroll', function(){
      if(wartet) return;
      wartet = true;
      requestAnimationFrame(function(){ aktualisiereSteuerung(); wartet = false; });
    }, { passive: true });

    var messTimer;
    window.addEventListener('resize', function(){
      clearTimeout(messTimer);
      messTimer = setTimeout(aktualisiereSteuerung, 150);
    });

    aktualisiereSteuerung();
    /* Nach dem Laden der Bilder können sich die Maße noch verschieben. */
    window.addEventListener('load', aktualisiereSteuerung);

    function openLightbox(index){
      currentIndex = (index + thumbs.length) % thumbs.length;
      var t = thumbs[currentIndex];
      trackEvent('referenz_geoeffnet', { absender: t.dataset.sender, datum: t.dataset.date });
      lbImg.src = t.dataset.full;
      lbImg.alt = t.querySelector('img').alt;
      lbCaption.innerHTML = '<strong>' + t.dataset.sender + '</strong><span>' + t.dataset.date + '</span>';
      lastFocused = document.activeElement;
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
      lbClose.focus();
    }
    function closeLightbox(){
      lightbox.hidden = true;
      document.body.style.overflow = '';
      if(lastFocused && lastFocused.focus) lastFocused.focus();
    }

    thumbs.forEach(function(t, i){
      t.addEventListener('click', function(){ openLightbox(i); });
    });
    lbClose.addEventListener('click', closeLightbox);
    lbPrev.addEventListener('click', function(){ openLightbox(currentIndex - 1); });
    lbNext.addEventListener('click', function(){ openLightbox(currentIndex + 1); });
    lightbox.addEventListener('click', function(e){ if(e.target === lightbox) closeLightbox(); });
    document.addEventListener('keydown', function(e){
      if(lightbox.hidden) return;
      if(e.key === 'Escape') closeLightbox();
      else if(e.key === 'ArrowLeft') openLightbox(currentIndex - 1);
      else if(e.key === 'ArrowRight') openLightbox(currentIndex + 1);
    });
  })();
</script>

</BaseLayout>
