              </button>
              <figcaption><strong>Bundesrepublik Deutschland, Der Bundeskanzler</strong><span>5. Februar 2002</span></figcaption>
            </figure>
            <figure class="tc-slide" data-index="13">
              <button type="button" class="tc-thumb" data-full={vollbild["/assets/testimonials/siemens-spls-2002.jpg"]} data-sender="Siemens SPLS · Jörg Mattern" data-date="28. Februar 2002" aria-label="Vergrößern: Siemens SPLS · Jörg Mattern, 28. Februar 2002">
                <Image src={asset("/assets/testimonials/siemens-spls-2002.jpg")} alt="Dankschreiben Siemens Procurement and Logistics Services" />
              </button>
              <figcaption><strong>Siemens SPLS · Jörg Mattern</strong><span>28. Februar 2002</span></figcaption>
            </figure>
            <figure class="tc-slide" data-index="14">
              <button type="button" class="tc-thumb" data-full={vollbild["/assets/testimonials/abb-airport-technologies-2002.jpg"]} data-sender="ABB Airport Technologies GmbH" data-date="18. März 2002" aria-label="Vergrößern: ABB Airport Technologies GmbH, 18. März 2002">
                <Image src={asset("/assets/testimonials/abb-airport-technologies-2002.jpg")} alt="Bestätigung ABB Airport Technologies GmbH" />
              </button>
