            </figure>
            <figure class="tc-slide" data-index="15">
              <button type="button" class="tc-thumb" data-full={vollbild["/assets/testimonials/ministerul-energeticii-moldova-2002-02.jpg"]} data-sender="Ministerul Energeticii al Republicii Moldova" data-date="2002" aria-label="Vergrößern: Ministerul Energeticii al Republicii Moldova, 2002">
                <Image src={asset("/assets/testimonials/ministerul-energeticii-moldova-2002-02.jpg")} alt="Dankschreiben des Energieministeriums der Republik Moldau" />
              </button>
              <figcaption><strong>Ministerul Energeticii al Republicii Moldova</strong><span>2002</span></figcaption>
            </figure>
            <figure class="tc-slide" data-index="16">
              <button type="button" class="tc-thumb" data-full={vollbild["/assets/testimonials/rexel-valentin-klein-2002-08.jpg"]} data-sender="REXEL Deutschland / Valentin Klein" data-date="12. August 2002" aria-label="Vergrößern: REXEL Deutschland / Valentin Klein, 12. August 2002">
                <Image src={asset("/assets/testimonials/rexel-valentin-klein-2002-08.jpg")} alt="Dankschreiben REXEL Deutschland Elektrofachgroßhandel" />
              </button>
              <figcaption><strong>REXEL Deutschland / Valentin Klein</strong><span>12. August 2002</span></figcaption>
