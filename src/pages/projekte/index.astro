---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { asset } from '../../lib/assets';
import Bildhinweis from '../../components/Bildhinweis.astro';
import Projektkachel from '../../components/Projektkachel.astro';
import Bewertungen from '../../components/Bewertungen.astro';
import { referenzenNachTyp, istHistorisch } from '../../data/referenzen';
import { useUi } from '../../i18n/ui';

/* Die Großansicht der Referenzschreiben wird erst im Browser gesetzt und kann
   deshalb nicht über die <Image>-Komponente laufen. getImage() erzeugt die
   optimierten Adressen beim Build; sie stehen als data-full am Vorschaubild. */
const vollbildPfade = [
  '/assets/testimonials/abb-airport-technologies-2002.jpg',
  '/assets/testimonials/assmann-beraten-planen-2003.jpg',
  '/assets/testimonials/beta-gmbh-2002.jpg',
  '/assets/testimonials/bundesamt-bauwesen-riga-2002.jpg',
  '/assets/testimonials/bundeskanzleramt-2002.jpg',
  '/assets/testimonials/bundestag-kansy-2002.jpg',
  '/assets/testimonials/energiewerkstatt-2002.jpg',
  '/assets/testimonials/expo2000-hannover-2000.jpg',
  '/assets/testimonials/imco-moldova-vereinbarung-2002.jpg',
  '/assets/testimonials/kaluga-brewing-company-2001.jpg',
  '/assets/testimonials/kbc-dankschreiben-2001.jpg',
  '/assets/testimonials/merten-2006.jpg',
  '/assets/testimonials/ministerul-energeticii-moldova-2002-01.jpg',
  '/assets/testimonials/ministerul-energeticii-moldova-2002-02.jpg',
  '/assets/testimonials/niedersaechsischer-landtag-heide-2002.jpg',
  '/assets/testimonials/niedersaechsischer-landtag-stolze-2001.jpg',
  '/assets/testimonials/rexel-valentin-klein-2002-08.jpg',
  '/assets/testimonials/siemens-spls-2002.jpg',
  '/assets/testimonials/sonepar-2002.jpg',
  '/assets/testimonials/valentin-klein-rexel-2002-01.jpg',
];

const vollbild: Record<string, string> = Object.fromEntries(
  await Promise.all(
    vollbildPfade.map(async (pfad) => [
      pfad,
      (await getImage({ src: asset(pfad), format: 'webp' })).src,
    ]),
  ),
);

const t = useUi(Astro.url);

/* Abgeschlossene Projekte der Unternehmenshistorie stehen hinter den übrigen,
   getrennt durch eine Überschrift mit der zeitlichen Einordnung. Die Trennung
   ergibt sich aus den Daten, nicht aus der Reihenfolge im Markup — sie kann
   deshalb nicht auseinanderlaufen, wenn eine Referenz umgestuft wird. */
const ersteHistorische = referenzenNachTyp.findIndex(istHistorisch);

/* Das Motiv im Referenzbereich ist eine KI-Visualisierung und trägt darunter
   den entsprechenden Hinweis. Für den Produktiveinsatz ist ein reales
   ELCON-Projektfoto vorzuziehen — siehe LIVEGANG_CHECKLISTE.md, Abschnitt 10. */
---

<BaseLayout title="Projekte & Referenzen" description="Realisierte Projekte der ELCON LED GmbH: Elektro-, HKLS- und Automatisierungstechnik für Industrie, Gewerbe und öffentliche Auftraggeber im In- und Ausland.">

  <section id="referenzen" style="padding-top:2.2rem;">
    <div class="wrap">
      <a href="/" class="subpage-back">← Zurück zur Startseite</a>
      <div class="section-head" id="generalunternehmer" style="max-width:none;">
        <p class="eyebrow">Ausgewählte Projekte</p>
        <h1>Realisierte Lösungen für unsere Kunden</h1>
        <p>Vom Automobilwerk über Hotellerie und Brauereien bis zur Botschaft: ELCON hat technische Gebäudeausrüstung für Industrie, Gewerbe und öffentliche Institutionen realisiert — von Werken in Deutschland und Polen über soziale Projekte in Ostafrika bis zu Projekten in Russland, der Ukraine und Zentralasien. Eine Auswahl aus drei Jahrzehnten:</p>
      </div>

      <div class="stat-strip" style="margin-bottom:2.6rem;">
        <div><span class="stat-num" data-zaehler="60" data-suffix="+">60+</span><span class="stat-label">realisierte Projekte</span></div>
        <div><span class="stat-num">1993</span><span class="stat-label">gegründet als ELCON LED GmbH</span></div>
        <div><span class="stat-num">Alle</span><span class="stat-label">Gewerke aus einer Hand</span></div>
        <div><span class="stat-num" data-zaehler="3">3</span><span class="stat-label">Kontinente mit Projekterfahrung</span></div>
      </div>


      <div class="project-grid" id="projectGrid">
        {referenzenNachTyp.map((r, i) => (
          <>
            {i === ersteHistorische && (
              <div class="projekt-trenner" id="historische-projekte">
                <h2>{t.historisch.ueberschrift}</h2>
                <p>{t.historisch.hinweisGruppe}</p>
              </div>
            )}
            <Projektkachel referenz={r} />
          </>
        ))}
      </div>

      <div class="projekt-aufklappen">
        <button
          type="button"
          class="cta-btn ghost"
          id="projekteMehr"
          aria-expanded="false"
          aria-controls="projectGrid"
          data-mehr="Weitere Projekte anzeigen"
          data-weniger="Weniger anzeigen"
          hidden
        >
          Weitere Projekte anzeigen
        </button>
      </div>



      <div class="reference-directory" id="refVerzeichnis">

        <!-- ABSCHNITT 1: AUSGEWÄHLTE REFERENZEN -->
        <section class="ref-showcase">
          <div class="ref-stage">
            <Image src={asset("/assets/offer/technik-msr.jpg")} width="900" height="519" alt="Technische Gebäudeausrüstung in einer Gewerbeimmobilie — Schaltschrank mit Gebäudeleittechnik" />
            
            <div class="ref-stage-overlay"></div>
            <div class="ref-stage-content wrap">
              <h2>Erfahrung, die Vertrauen schafft</h2>
            </div>
          </div>
          <Bildhinweis art="projekt" />

        </section>

        <!-- ABSCHNITT 2: BRANCHEN- UND PROJEKTERFAHRUNG -->
        <section class="ref-industries">
          <div class="wrap">
            <div class="section-head" style="margin-bottom:1.8rem;max-width:none;">
              <p class="eyebrow">Kundenübersicht</p>
              <h2>Branchen und Märkte im internationalen Projektgeschäft</h2>
              <p>Von Automotive und Industrie über Gewerbeimmobilien bis zu öffentlichen und internationalen Projekten.</p>
            </div>

            <div class="ref-groups">
              <div class="ref-group-card">
                <div class="ref-group-top">
                  <span class="ref-group-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 16l1.5-5a2 2 0 011.9-1.4h9.2A2 2 0 0118.5 11l1.5 5"/><path d="M3 16h18v2a1 1 0 01-1 1h-1.5a1 1 0 01-1-1v-1H6.5v1a1 1 0 01-1 1H4a1 1 0 01-1-1v-2z"/><circle cx="7" cy="17.5" r="1.3"/><circle cx="17" cy="17.5" r="1.3"/></svg></span>
                  <div>
                    <span class="ref-group-line" style="background:var(--ink);"></span>
                    <h3>Industrie &amp; Automotive</h3>
                  </div>
                </div>
                <ul class="ref-group-list two-col">
                  <li>Volkswagen AG</li><li>Porsche</li><li>General Motors</li><li>Continental AG</li><li>Benteler AG Automobiltechnik</li><li>ThyssenKrupp: Schiffslackiererei</li>
                </ul>
                <ul class="ref-group-list two-col" style="margin-top:.7rem;">
                  <li>CLAAS Landmaschinen</li><li>Egger Spanplattenwerk</li><li>Kronospan</li><li>ZAO Rolf Estate – Mitsubishi Autohaus</li><li>Lexus-Autohaus</li><li>Vental Stahlfabrik</li><li>Schubbeize</li><li>Ziegelwerk</li><li>Rani Plast</li>
                </ul>
              </div>

              <div class="ref-group-card">
                <div class="ref-group-top">
                  <span class="ref-group-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="4" width="10" height="16"/><path d="M15 11h4v9h-4"/><path d="M8 8h2M8 12h2M8 16h2"/></svg></span>
                  <div>
                    <span class="ref-group-line" style="background:var(--accent-3);"></span>
                    <h3>Gewerbe, Immobilien &amp; Hospitality</h3>
                  </div>
                </div>
                <ul class="ref-group-list">
                  <li>Bau Grund AG</li><li>HOCHTIEF</li><li>Internationales Handelszentrum „Moskva City“</li><li>Hotel Golden Apple</li><li>Messeorganisation „Kazakhstan International Exposition“</li><li>World Class Fitness Club</li>
                </ul>
                <ul class="ref-group-list" style="margin-top:.7rem;">
                  <li>AMR (Philipp Holzmann AG)</li><li>Bautech</li>
                </ul>
              </div>

              <div class="ref-group-card">
                <div class="ref-group-top">
                  <span class="ref-group-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9l8-5 8 5"/><path d="M4 9h16"/><path d="M6 9v9M10 9v9M14 9v9M18 9v9"/><path d="M3 20h18"/></svg></span>
                  <div>
                    <span class="ref-group-line" style="background:var(--accent);"></span>
                    <h3>Öffentliche Auftraggeber &amp; Diplomatie</h3>
                  </div>
                </div>
                <ul class="ref-group-list two-col">
                  <li>Auswärtiges Amt</li><li>Botschaft der Europäischen Union</li><li>SOS-Kinderdorf International</li><li>OSZE-Hauptquartier</li><li>OSZE-Wirtschaftsfakultät</li><li>OSZE-Regierungsgebäude</li>
                </ul>
                <ul class="ref-group-list two-col" style="margin-top:.7rem;">
                  <li>OSZE-Polizeischule</li><li>Visaamt</li><li>Flughafen</li><li>Care International</li>
                </ul>
              </div>

              <div class="ref-group-card">
                <div class="ref-group-top">
                  <span class="ref-group-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.5 4 5.7 4 9s-1.5 6.5-4 9c-2.5-2.5-4-5.7-4-9s1.5-6.5 4-9z"/></svg></span>
                  <div>
                    <span class="ref-group-line" style="background:var(--accent-3);"></span>
                    <h3>Internationale Industrie- und Sonderprojekte</h3>
                  </div>
                </div>
                <div class="ref-subgroup">
                  <h4>Banken</h4>
                  <ul class="ref-group-list two-col"><li>Aeroflot-Bank</li><li>Toko-Bank</li><li>Europäische Handelsbank</li><li>Westdeutsche Landesbank</li></ul>
                </div>
                <div class="ref-subgroup">
                  <h4>Brauereien</h4>
                  <ul class="ref-group-list two-col"><li>Siemens: Brauerei Sosnadar</li><li>KBC – Kaluga Brewing Company</li><li>Stepan Rasin Brauerei</li><li>Tinkoff Brauerei</li><li>SABMiller</li><li>Belarus Brauerei-Gesellschaft</li><li>Baltika Brauerei Holding</li><li>Susyndar Brauerei</li><li>Huppmann Tuchenhagen Brewery Systems</li></ul>
                </div>
                <div class="ref-subgroup">
                  <h4>Büro und weitere Projekte</h4>
                  <ul class="ref-group-list two-col"><li>Hoffmann-La Roche</li><li>Johnson &amp; Johnson</li><li>Interros Estate</li><li>Siemens AG / Rospatentamt</li></ul>
                </div>
              </div>
            </div>
          </div>
        </section>
      </div>

      <div class="testimonial-carousel" id="kundenfeedback">
        <div class="section-head" style="margin-bottom:1.4rem;max-width:none;">
          <p class="eyebrow">Kundenfeedback</p>
          <h2>Was unsere Kunden über uns sagen</h2>
          <p>Dankschreiben und Empfehlungen von Kunden, Geschäftspartnern und Institutionen aus mehr als zwei Jahrzehnten — ein Ausschnitt aus dem ELCON-Archiv. Zum Vergrößern anklicken.</p>
        </div>
        <div class="tc-viewport">
          <button type="button" class="tc-nav tc-prev" id="tcPrev" aria-label="Vorheriges Schreiben">&#8249;</button>
          <div class="tc-track" id="tcTrack">
            <figure class="tc-slide" data-index="0">
              <button type="button" class="tc-thumb" data-full={vollbild["/assets/testimonials/expo2000-hannover-2000.jpg"]} data-sender="EXPO 2000 Hannover GmbH" data-date="31. Oktober 2000" aria-label="Vergrößern: EXPO 2000 Hannover GmbH, 31. Oktober 2000">
                <Image src={asset("/assets/testimonials/expo2000-hannover-2000.jpg")} alt="Dankschreiben EXPO 2000 Hannover GmbH für die Ticketvertriebs-Partnerschaft" />
              </button>
              <figcaption><strong>EXPO 2000 Hannover GmbH</strong><span>31. Oktober 2000</span></figcaption>
            </figure>
            <figure class="tc-slide" data-index="1">
              <button type="button" class="tc-thumb" data-full={vollbild["/assets/testimonials/kaluga-brewing-company-2001.jpg"]} data-sender="The Kaluga Brewing Company" data-date="13. März 2001" aria-label="Vergrößern: The Kaluga Brewing Company, 13. März 2001">
                <Image src={asset("/assets/testimonials/kaluga-brewing-company-2001.jpg")} alt="Empfehlungsschreiben The Kaluga Brewing Company" />
              </button>
              <figcaption><strong>The Kaluga Brewing Company</strong><span>13. März 2001</span></figcaption>
            </figure>
            <figure class="tc-slide" data-index="2">
              <button type="button" class="tc-thumb" data-full={vollbild["/assets/testimonials/kbc-dankschreiben-2001.jpg"]} data-sender="Kaluga Brewing Company" data-date="15. Juni 2001" aria-label="Vergrößern: Kaluga Brewing Company, 15. Juni 2001">
                <Image src={asset("/assets/testimonials/kbc-dankschreiben-2001.jpg")} alt="Dankschreiben Kaluga Brewing Company" />
              </button>
              <figcaption><strong>Kaluga Brewing Company</strong><span>15. Juni 2001</span></figcaption>
            </figure>
            <figure class="tc-slide" data-index="3">
              <button type="button" class="tc-thumb" data-full={vollbild["/assets/testimonials/niedersaechsischer-landtag-stolze-2001.jpg"]} data-sender="Niedersächsischer Landtag · M. Stolze MdL" data-date="17. November 2001" aria-label="Vergrößern: Niedersächsischer Landtag · M. Stolze MdL, 17. November 2001">
