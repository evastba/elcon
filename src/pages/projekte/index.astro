              </button>
              <figcaption><strong>Ministerul Energeticii al Republicii Moldova</strong><span>22. Januar 2002</span></figcaption>
            </figure>
            <figure class="tc-slide" data-index="8">
              <button type="button" class="tc-thumb" data-full={vollbild["/assets/testimonials/energiewerkstatt-2002.jpg"]} data-sender="energiewerkstatt GmbH" data-date="23. Januar 2002" aria-label="Vergrößern: energiewerkstatt GmbH, 23. Januar 2002">
                <Image src={asset("/assets/testimonials/energiewerkstatt-2002.jpg")} alt="Dankschreiben energiewerkstatt Gesellschaft für rationelle Energieverwendung mbH" />
              </button>
              <figcaption><strong>energiewerkstatt GmbH</strong><span>23. Januar 2002</span></figcaption>
            </figure>
            <figure class="tc-slide" data-index="9">
              <button type="button" class="tc-thumb" data-full={vollbild["/assets/testimonials/beta-gmbh-2002.jpg"]} data-sender="beta GmbH" data-date="24. Januar 2002" aria-label="Vergrößern: beta GmbH, 24. Januar 2002">
