            </figure>
            <figure class="tc-slide" data-index="7">
              <button type="button" class="tc-thumb" data-full={vollbild["/assets/testimonials/ministerul-energeticii-moldova-2002-01.jpg"]} data-sender="Ministerul Energeticii al Republicii Moldova" data-date="22. Januar 2002" aria-label="Vergrößern: Ministerul Energeticii al Republicii Moldova, 22. Januar 2002">
