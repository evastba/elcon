---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Kennzahlen from '../../components/Kennzahlen.astro';
import Kompetenzfelder from '../../components/Kompetenzfelder.astro';
import AktuelleProjekte from '../../components/AktuelleProjekte.astro';
import WarumElcon from '../../components/WarumElcon.astro';
import Projektablauf from '../../components/Projektablauf.astro';
import Leistungsfinder from '../../components/Leistungsfinder.astro';
import Ansprechpartner from '../../components/Ansprechpartner.astro';
import Partnerunternehmen from '../../components/Partnerunternehmen.astro';
import { asset } from '../../lib/assets';
import { getLang, pfad } from '../../i18n/ui';
import { STARTSEITE } from '../../i18n/startseite';

/* Reihenfolge der Abschnitte — jeder hat eine eigene Aufgabe:
   1 Einstieg und Positionierung · 2 Vertrauen (Laufschrift und Kennzahlen) ·
   3 Kompetenzfelder ·
   4 aktuelle Referenzen · 5 Unterscheidungsmerkmale · 6 Projektablauf ·
   7 Leistungsfinder · 8 Unternehmen und Ansprechpartner.

   Ein eigener Abschlussbereich mit "Projekt besprechen" stand hier zuvor;
   er ist entfallen, weil die Fußzeile unmittelbar darunter denselben Knopf
   trägt.

   Die Logo-Laufschrift steht bewusst nicht im Einstieg: Sie belegt Vertrauen,
   beantwortet aber keine der Fragen, die ein Besucher zuerst hat. Sie sitzt
   deshalb im Vertrauensabschnitt, gemeinsam mit den Kennzahlen unter einer
   Überschrift. */

const lang = getLang(Astro.url);
const t = STARTSEITE[lang];
const kontakt = pfad('/kontakt/', lang);
const projekte = pfad('/projekte/', lang);
---

<BaseLayout title={t.meta.titel} description={t.meta.beschreibung} rawTitle>

  <section class="hero">
    <div class="wrap">
      <div class="hero-text">
        <p class="eyebrow eyebrow-plain">{t.hero.eyebrow}</p>
        <h1>{t.hero.h1.map((z, i) => (i === 0 ? z : <><br />{z}</>))}</h1>
        <p class="lead">{t.hero.lead}</p>
        <p class="hero-vertrauen">{t.hero.vertrauen}</p>
        <div class="hero-ctas">
          <a class="cta-btn primary" href={kontakt}>{t.hero.ctaPrimaer}</a>
          <a class="cta-btn ghost" href={projekte}>{t.hero.ctaSekundaer}</a>
        </div>
      </div>
      <div class="hero-art">
          <Image src={asset("/assets/hero-building.jpg")} alt={t.hero.bildAlt} widths={[480, 760, 1008]} sizes="(max-width: 900px) 100vw, 46vw" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  <Kennzahlen />

  <Kompetenzfelder />

  <AktuelleProjekte />

  <WarumElcon />

  <Projektablauf />

  <Leistungsfinder />

  <section class="unternehmen-teaser" style="background:var(--surface-alt)">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{t.unternehmen.eyebrow}</p>
        <h2>{t.unternehmen.titel}</h2>
        <p>{t.unternehmen.text}</p>
      </div>
      <Ansprechpartner />

      <div class="hero-ctas">
        <a class="cta-btn primary" href="/en/company/">{t.unternehmen.link}</a>
      </div>
    </div>
  </section>

  <Partnerunternehmen />

</BaseLayout>
