---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LogoMarquee from '../../components/LogoMarquee.astro';
import { asset } from '../../lib/assets';
import Bildhinweis from '../../components/Bildhinweis.astro';
import { company } from '../../config';

/* Die Gewerke stehen ausführlich auf /en/services/. Hier nur die Namen als
   Anreißer — derselbe Wortlaut wie dort, damit nichts auseinanderläuft. */
const trades = [
  'Electrical engineering',
  'Heating, air conditioning, ventilation, plumbing',
  'Communications technology',
  'Lighting technology',
  'Network technology & IT',
  'Instrumentation, control & building automation',
  'Fire protection & security systems',
  'Project management & consulting',
];
---

<BaseLayout
  title="ELCON — main contractor for building services engineering"
  description="Main contractor for building services engineering: electrical, heating, air conditioning, ventilation, plumbing and automation systems from a single source."
  rawTitle
>

  <section class="hero">
    <div class="wrap">
      <div>
        <p class="eyebrow eyebrow-plain">Main contractor for building services engineering</p>
        <h1>Complex projects<br>from a single source<br>with 30+ years of expertise.</h1>
        <p class="lead">ELCON brings electrical, heating, air conditioning, ventilation, plumbing and automation systems together into one promise: a single point of contact, rooted in Germany with international project experience, engineered for measurable energy efficiency.</p>
        <div class="hero-ctas">
          <a class="cta-btn primary" href="/en/projects/">View projects</a>
          <a class="cta-btn ghost" href="/en/contact/">Enquire about a project</a>
        </div>
      </div>
      <div class="hero-medien">
        <div class="hero-art">
          <Image src={asset("/assets/hero-building.jpg")} alt="Modern commercial building with technical building services" loading="eager" fetchpriority="high" />
        </div>
        <Bildhinweis art="symbolisch" />
      </div>
    </div>
    <div class="wrap">
      <LogoMarquee />
    </div>
  </section>

  <section style="background:var(--surface-alt)">
    <div class="wrap">
      <div class="section-head" style="margin-bottom:1.8rem;">
        <p class="eyebrow">Every trade, one partner</p>
        <h2>Services at a glance</h2>
      </div>
      <p class="offer-lead">We round out our expertise across every trade in technical plant construction with a service tailored to each phase in the life of your property — turnkey building services from a single source, from the first design through to ongoing maintenance.</p>
      <div class="offer-domains" style="margin-top:1.4rem;">
        {trades.map((t) => <span class="offer-domain-tag">{t}</span>)}
      </div>
      <div class="hero-ctas" style="margin-top:1.8rem;">
        <a class="cta-btn primary" href="/en/services/">View all services</a>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head" style="margin-bottom:1.4rem;">
        <p class="eyebrow">Contact</p>
        <h2>Enquire about a project</h2>
      </div>
      <p class="offer-lead">Tell us about your project — we will come back to you with a dedicated point of contact.</p>
      <div class="hero-ctas" style="margin-top:1.6rem;">
        <a class="cta-btn primary" href="/en/contact/">Go to the enquiry form</a>
        <a class="cta-btn ghost" href={`tel:${company.phoneHref}`}>{company.phone}</a>
      </div>
    </div>
  </section>

</BaseLayout>
