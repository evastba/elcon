---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Leistungsfinder from '../../components/Leistungsfinder.astro';
import { asset } from '../../lib/assets';
import KiMarke from '../../components/KiMarke.astro';
import Anlagentechnik from '../../components/Anlagentechnik.astro';
---

<BaseLayout title="Services" description="Electrical engineering, HVAC and plumbing, instrumentation and building automation, network technology, fire protection and project management — every building services trade from a single source.">

  <section id="services" style="background:var(--surface-alt)">
    <div class="wrap">
      <div class="section-head" style="margin-bottom:1.8rem;">
        <p class="eyebrow">Every trade, one partner</p>
        <h1>Services at a glance</h1>
      </div>


      <div class="offer-band">
        <p class="eyebrow" style="margin-bottom:.6rem;">What we offer</p>
        <h3 style="margin:0 0 .8rem;font-size:1.15rem;font-weight:800;">Engineering and service offering</h3>
        <p class="offer-lead">We round out our expertise across every trade in technical plant construction with a service tailored to each phase in the life of your property — turnkey building services from a single source, from the first design through to ongoing maintenance.</p>
        <div class="offer-domains">
          <span class="offer-domain-tag">Mechanical services (heating, air conditioning, ventilation, plumbing)</span>
          <span class="offer-domain-tag">Electrical engineering</span>
          <span class="offer-domain-tag">Fire protection</span>
        </div>
        <div class="phase-grid">
          <div class="phase-item">
            <div class="phase-photo"><Image src={asset("/assets/leistungen/planbesprechung-baustelle.jpg")} alt="Two engineers discussing construction drawings on site" /><KiMarke /></div>
            <div class="phase-item-body">
              <div class="phase-num">01</div>
              <h3>Design &amp; engineering</h3>
              <p>Design of all indoor and outdoor electrical installations up to 10 kV, of mechanical building services and of the safety systems (fire protection, alarm systems) — including coordination with the relevant supervisory authorities.</p>
            </div>
          </div>
          <div class="phase-item">
            <div class="phase-photo"><Image src={asset("/assets/leistungen/team-montage.jpg")} alt="Four-strong installation team fitting a switchgear cabinet on site" /><KiMarke /></div>
            <div class="phase-item-body">
              <div class="phase-num">02</div>
              <h3>Installation</h3>
              <p>Installation of indoor and outdoor electrical systems up to 10 kV, of mechanical building services and of the safety systems — delivered turnkey from a single source.</p>
            </div>
          </div>
          <div class="phase-item">
            <div class="phase-photo"><Image src={asset("/assets/leistungen/thermografie.jpg")} alt="Engineer carrying out a thermographic inspection of a switchgear assembly" /><KiMarke /></div>
            <div class="phase-item-body">
              <div class="phase-num">03</div>
              <h3>Servicing, maintenance &amp; repair</h3>
              <p>Technical servicing, maintenance and repair of electrical installations, mechanical building services and fire protection systems across the entire life cycle of the installation.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="capability-strip" id="leistungsfelder">
        <div class="capability-item">
          <div class="hex-icon"><svg viewBox="0 0 24 24"><path d="M13 2 4 14h7l-1 8 9-12h-7z"/></svg></div>
          <div>
            <h3>Electrical engineering</h3>
            <p>Electrical installations of every kind, systems up to 10 kV, power generation and distribution up to 36 kV.</p>
          </div>
        </div>
        <div class="capability-item">
          <div class="hex-icon"><svg viewBox="0 0 24 24"><path d="M12 3c2 2.5 4 5.2 4 8a4 4 0 0 1-8 0c0-2.8 2-5.5 4-8Z"/><path d="M12 13v8"/></svg></div>
          <div>
            <h3>Heating, air conditioning, ventilation, plumbing</h3>
            <p>Mechanical services across all trades — designed, installed and maintained from a single source.</p>
          </div>
        </div>
        <figure class="capability-photo">
          <Image src={asset("/assets/leistungen/msr-handheld.jpg")} alt="Engineer programming a PLC controller with a handheld terminal at the control cabinet" /><KiMarke />
          
          <figcaption>Control technology in practice</figcaption>
        </figure>
        <div class="capability-item">
          <div class="hex-icon"><svg viewBox="0 0 24 24"><path d="M4 5h16v11H8l-4 4V5Z"/><path d="M8 9h8M8 12h5"/></svg></div>
          <div>
            <h3>Communications technology</h3>
            <p>Communication and signalling systems — confidently handled across the full range of system families.</p>
          </div>
        </div>
        <div class="capability-item">
          <div class="hex-icon"><svg viewBox="0 0 24 24"><path d="M9 18h6M10 21h4"/><path d="M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1.1 2.1h4.8c.1-.9.5-1.6 1.1-2.1A6 6 0 0 0 12 3Z"/></svg></div>
          <div>
            <h3>Lighting technology</h3>
            <p>From general lighting in residential and commercial buildings through to the illumination of industrial plants and bespoke solutions.</p>
          </div>
        </div>
        <div class="capability-item">
          <div class="hex-icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="5" r="2.2"/><circle cx="5" cy="19" r="2.2"/><circle cx="19" cy="19" r="2.2"/><path d="M12 7.2 6.4 17M12 7.2 17.6 17M7.2 19h9.6"/></svg></div>
          <div>
            <h3>Network technology &amp; IT</h3>
            <p>Structured cabling, fibre optics and active network components to the current state of the art.</p>
          </div>
        </div>
        <div class="capability-item">
          <div class="hex-icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/></svg></div>
          <div>
            <h3>Instrumentation &amp; building automation</h3>
            <p>DDC and PLC control systems, building automation and industrial control installations, individually engineered and documented in several languages.</p>
          </div>
        </div>
        <div class="capability-item">
          <div class="hex-icon"><svg viewBox="0 0 24 24"><path d="M12 3l7 3v6c0 4.5-3 8-7 9-4-1-7-4.5-7-9V6l7-3Z"/></svg></div>
          <div>
            <h3>Fire protection &amp; security systems</h3>
            <p>Fire detection and security systems for commercial, industrial and public buildings.</p>
          </div>
        </div>
        <div class="capability-item">
          <div class="hex-icon"><svg viewBox="0 0 24 24"><path d="M5 4h14v16l-7-4-7 4Z"/><path d="M9 9h6M9 13h6"/></svg></div>
          <div>
            <h3>Project management &amp; consulting</h3>
            <p>Technical consulting, calculation and verification, project control, site management and as-built documentation.</p>
          </div>
        </div>
        <figure class="capability-photo">
          <Image src={asset("/assets/leistungen/kabeltrasse.jpg")} alt="Cable tray with structured cabling and connection terminals below the ceiling" />
          
          <figcaption>Structured cabling &amp; network technology</figcaption>
        </figure>
      </div>

      <div class="lifecycle-band">
        <div class="lifecycle-photo"><Image src={asset("/assets/leistungen/beratung-anlage.jpg")} alt="Engineer advising two colleagues with a tablet in front of a heating and air conditioning plant" /><KiMarke /></div>
        <div class="hex-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 1 3 6.7"/><path d="M3 12v6h6"/></svg></div>
        <div>
          <h3>We look after installations for their whole life</h3>
          <p>Once a plant is complete we keep servicing it, clearing faults and improving it — verified with modern measuring equipment and documented in several languages, so that the operating life and the service life of the components are used to the full.</p>
        </div>
      </div>

      <Anlagentechnik />
    </div>
  </section>

  <Leistungsfinder />

</BaseLayout>
