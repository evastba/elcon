---
import BaseLayout from '../layouts/BaseLayout.astro';
import { company } from '../config';
---

<BaseLayout title="Kontakt" description="Projektanfrage an die ELCON LED GmbH — Bauernstr. 34, 31275 Lehrte. Telefon, E-Mail, WhatsApp und Anfrageformular.">

  <section id="kontakt" class="contact">
    <div class="wrap kontakt-raster">
      <div class="contact-info">
        <p class="eyebrow">Kontakt</p>
        <h1 style="font-size:clamp(1.6rem,3vw,2.1rem);font-weight:800;margin:0 0 1rem;">Projekt anfragen</h1>
        <p style="color:var(--text-muted);line-height:1.6;max-width:42ch;">Schildern Sie uns Ihr Vorhaben — wir melden uns mit einem festen Ansprechpartner zurück.</p>
        <h3>{company.name}</h3>
        <ul class="contact-list">
          <li>{company.street}</li>
          <li>{company.zip} {company.city}</li>
          <li>Telefon: <a href={`tel:${company.phoneHref}`}>{company.phone}</a></li>
          <li>Fax: {company.fax}</li>
          <li><a href={`mailto:${company.email}`}>{company.email}</a></li>
        </ul>
        <a class="whatsapp-link" href="https://wa.me/4951757716116" target="_blank" rel="noopener">
          <span class="whatsapp-badge" aria-hidden="true">
            <svg viewBox="0 0 32 32"><path fill="#25D366" d="M16.004 0C7.164 0 0 7.163 0 16c0 2.82.738 5.566 2.14 7.982L0 32l8.223-2.13A15.94 15.94 0 0016.004 32C24.84 32 32 24.837 32 16S24.84 0 16.004 0z"/><path fill="#fff" d="M24.14 19.13c-.406-.203-2.4-1.184-2.773-1.32-.372-.136-.643-.203-.914.204-.27.406-1.05 1.32-1.287 1.59-.237.27-.474.305-.88.102-.406-.204-1.715-.632-3.267-2.017-1.208-1.077-2.024-2.407-2.261-2.813-.237-.406-.025-.626.178-.828.183-.183.406-.474.61-.712.202-.237.27-.406.405-.677.135-.27.068-.508-.034-.712-.102-.203-.914-2.202-1.252-3.016-.33-.792-.665-.685-.914-.698-.237-.012-.508-.014-.78-.014-.27 0-.71.101-1.082.508-.372.406-1.42 1.388-1.42 3.387 0 1.998 1.454 3.929 1.657 4.2.203.27 2.862 4.37 6.933 6.13.969.418 1.724.668 2.313.855.972.31 1.856.266 2.556.161.78-.116 2.4-.981 2.738-1.928.338-.948.338-1.76.237-1.929-.101-.169-.372-.27-.778-.474z"/></svg>
          </span>
          <span>Direkt per WhatsApp schreiben</span>
        </a>
      </div>
      <form class="request" id="requestForm">
        <div class="form-row">
          <div class="field">
            <label for="fname">Name <span class="pflicht" aria-hidden="true">*</span></label>
            <input id="fname" name="name" type="text" autocomplete="name" required>
          </div>
          <div class="field">
            <label for="fcompany">Unternehmen</label>
            <input id="fcompany" name="company" type="text" autocomplete="organization">
          </div>
        </div>
        <div class="form-row">
          <div class="field">
            <label for="fmail">E-Mail <span class="pflicht" aria-hidden="true">*</span></label>
            <input id="fmail" name="email" type="email" autocomplete="email" required>
          </div>
          <div class="field">
            <label for="fphone">Telefon</label>
            <input id="fphone" name="phone" type="tel" autocomplete="tel">
          </div>
        </div>
        <div class="form-row">
          <div class="field">
            <label for="ftopic">Leistungsbereich</label>
            <select id="ftopic" name="topic">
              <option>Elektrotechnik</option>
              <option>Heizung, Klima, Lüftung, Sanitär</option>
              <option>MSR- &amp; Automatisierungstechnik</option>
              <option>Netzwerktechnik &amp; IT</option>
              <option>Planung &amp; Betrieb / Sonstiges</option>
            </select>
          </div>
          <div class="field">
            <label for="flocation">Standort des Projekts</label>
            <input id="flocation" name="location" type="text" placeholder="Ort oder Region">
          </div>
        </div>
        <div class="field">
          <label for="fmsg">Projektbeschreibung <span class="pflicht" aria-hidden="true">*</span></label>
          <textarea id="fmsg" name="message" required></textarea>
        </div>
        <button type="submit" class="cta-btn primary" style="justify-content:center;">Anfrage senden</button>
        <p class="form-note">
          Öffnet Ihr E-Mail-Programm mit vorausgefüllter Nachricht an {company.email}.
          Pläne, Leistungsverzeichnisse oder Fotos hängen Sie dort direkt an — eine
          Anbindung mit Datei-Upload folgt.
        </p>

        <p class="form-direkt">
          Lieber direkt schreiben?
          <a href={`mailto:${company.email}`}>{company.email}</a>
        </p>
      </form>
    </div>

    <div class="wrap">
      <div class="kontakt-hilfe">
        <div>
          <h2>Was uns bei Ihrer Anfrage hilft</h2>
          <p>Je genauer wir Ihr Vorhaben kennen, desto belastbarer fällt unsere Rückmeldung aus. Hilfreich sind Angaben zu:</p>
          <ul>
            <li><strong>Art des Gebäudes</strong> — Neubau, Umbau im laufenden Betrieb oder Sanierung im Bestand</li>
            <li><strong>Gewerken</strong>, die Sie vergeben möchten, und ob wir sie gebündelt übernehmen sollen</li>
            <li><strong>Standort</strong> und geplantem Zeitrahmen</li>
            <li><strong>Leistungsphase</strong> — erste Idee, laufende Planung oder fertige Ausschreibung</li>
            <li><strong>vorhandenen Unterlagen</strong> wie Leistungsverzeichnis, Plänen oder Bestandsaufnahmen</li>
          </ul>
        </div>

        <div>
          <h2>Wege zu uns</h2>
          <dl class="kontakt-wege">
            <div>
              <dt>Telefon</dt>
              <dd><a href={`tel:${company.phoneHref}`}>{company.phone}</a></dd>
            </div>
            <div>
              <dt>E-Mail</dt>
              <dd><a href={`mailto:${company.email}`}>{company.email}</a></dd>
            </div>
            <div>
              <dt>WhatsApp</dt>
              <dd><a href="https://wa.me/4951757716116" target="_blank" rel="noopener">Nachricht schreiben</a></dd>
            </div>
            <div>
              <dt>Telefax</dt>
              <dd>{company.fax}</dd>
            </div>
          </dl>
        </div>

        <div>
          <h2>Anschrift</h2>
          <address class="kontakt-anschrift">
            {company.name}<br />
            {company.street}<br />
            {company.zip} {company.city}<br />
            {company.country}
          </address>
          <p class="kontakt-karte">
            <a
              href={`https://www.openstreetmap.org/search?query=${encodeURIComponent(`${company.street}, ${company.zip} ${company.city}`)}`}
              target="_blank"
              rel="noopener noreferrer"
            >Auf der Karte ansehen</a>
          </p>
          <p class="kontakt-hinweis">
            Unterlagen wie Leistungsverzeichnisse oder Pläne senden Sie am besten
            per E-Mail — sie erreichen uns dort am schnellsten.
          </p>
        </div>
      </div>
    </div>
  </section>

<script>
  import { trackEvent } from '../scripts/track';

  document.getElementById('requestForm').addEventListener('submit', function(e){
    e.preventDefault();
    var f = e.target;
    trackEvent('anfrage_abgesendet', { leistungsbereich: f.topic.value });
    var subject = encodeURIComponent('Projektanfrage: ' + (f.topic.value || 'ELCON'));
    /* Leere Felder weglassen, damit die Nachricht nicht mit Platzhaltern
       beginnt. */
    var zeilen = [
      ['Name', f.name.value],
      ['Unternehmen', f.company.value],
      ['E-Mail', f.email.value],
      ['Telefon', f.phone.value],
      ['Leistungsbereich', f.topic.value],
      ['Standort', f.location.value],
    ].filter(function(z){ return z[1] && z[1].trim(); })
     .map(function(z){ return z[0] + ': ' + z[1].trim(); });

    var body = encodeURIComponent(
      zeilen.join('\n') + '\n\n' + f.message.value
    );
    window.location.href = 'mailto:info@elcon-led.com?subject=' + subject + '&body=' + body;
  });
</script>

</BaseLayout>
