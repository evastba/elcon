<script>
  var CLIENTS = [
    {name:"Volkswagen", logo:"/assets/logos/volkswagen.png", size:"lg"},
    {name:"Porsche", logo:"/assets/logos/porsche.png", size:"lg"},
    {name:"Heineken", logo:"/assets/logos/heineken.png", size:"lg"},
    {name:"Nord Stream", logo:"/assets/logos/nordstream.png"},
    {name:"Nord Stream 2", logo:"/assets/logos/nordstream2.png"},
    {name:"Continental", logo:"/assets/logos/continental.png"},
    {name:"Selgros", logo:"/assets/logos/selgros.png"},
    {name:"Auswärtiges Amt", logo:"/assets/logos/auswaertiges-amt.png"},
    {name:"Hilton", logo:"/assets/logos/hilton.png"},
    {name:"Siemens", logo:"/assets/logos/siemens.png"},
    {name:"thyssenkrupp", logo:"/assets/logos/thyssenkrupp.png"},
    {name:"Johnson & Johnson", logo:"/assets/logos/johnson-johnson.png"},
    {name:"SOS-Kinderdorf International", logo:"/assets/logos/sos-kinderdorf.png"},
    {name:"General Motors", logo:"/assets/logos/gm.png"},
    {name:"Hyatt", logo:"/assets/logos/hyatt.png"},
    {name:"AB InBev", logo:"/assets/logos/inbev.png"},
    {name:"Ambassador Hotel", logo:"/assets/logos/ambassador-hotel.png"},
    {name:"Audi", logo:"/assets/logos/audi.png"},
    {name:"Benteler", logo:"/assets/logos/benteler.png"},
    {name:"BILLA", logo:"/assets/logos/billa.png"},
    {name:"Schweizerische Eidgenossenschaft", logo:"/assets/logos/schweiz-konsulat.png"},
    {name:"СтройСервис", logo:"/assets/logos/stroyservis.png"},
    {name:"Aeroflot-Bank", logo:"/assets/logos/aeroflot-bank.png"},
    {name:"Care International", logo:"/assets/logos/care.png"},
    {name:"Bautech", logo:"/assets/logos/bautech.png"},
    {name:"Botschaft der Europäischen Union", logo:"/assets/logos/eu.png"},
    {name:"OSZE", logo:"/assets/logos/osce.png"},
    {name:"Mitsubishi", logo:"/assets/logos/mitsubishi.png"},
    {name:"Bau Grund AG", logo:"/assets/logos/baugrund.png"},
    {name:"Philipp Holzmann AG", logo:"/assets/logos/philipp-holzmann.png"},
    {name:"HOCHTIEF", logo:"/assets/logos/hochtief.png"},
    {name:"Hoffmann-La Roche", logo:"/assets/logos/roche.png"},
    {name:"STREIF", logo:"/assets/logos/streif.png"}
  ];
  var track = document.getElementById('marqueeTrack');
  var doubled = CLIENTS.concat(CLIENTS);
  track.innerHTML = doubled.map(function(c){
    var sizeClass = c.size === 'lg' ? ' marquee-logo--lg' : '';
    return c.logo
      ? '<span class="marquee-logo' + sizeClass + '"><img src="' + c.logo + '" alt="' + c.name + '" loading="lazy"></span>'
      : '<span class="marquee-logo marquee-logo-text' + sizeClass + '">' + c.name + '</span>';
  }).join('');

  function showToast(msg){
    var t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('show');
    clearTimeout(window.__toastTimer);
    window.__toastTimer = setTimeout(function(){ t.classList.remove('show'); }, 3600);
  }

  function setLang(lang, btn){
    var group = btn.closest('.lang-toggle');
    Array.prototype.forEach.call(group.querySelectorAll('button'), function(b){
      b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
    });
    if(lang === 'en'){
      showToast('Die vollständige englische Version wird in der nächsten Ausbaustufe ergänzt.');
    }
  }

  document.querySelectorAll('.filter-chip').forEach(function(btn){
    btn.addEventListener('click', function(){
      document.querySelectorAll('.filter-chip').forEach(function(b){
        b.classList.remove('is-active');
        b.setAttribute('aria-pressed','false');
      });
      btn.classList.add('is-active');
      btn.setAttribute('aria-pressed','true');
      var f = btn.dataset.filter;
      document.querySelectorAll('#projectGrid .project-card').forEach(function(card){
        card.hidden = !(f === 'all' || card.dataset.category === f);
      });
    });
  });

  function notReady(e){
    e.preventDefault();
    showToast('Rechtstext folgt vor Livegang der Seite.');
    return false;
  }

  /* Cookie-Consent + Analytics (Platzhalter-Tracking)
     GA_MEASUREMENT_ID ist ein Platzhalter — vor Livegang durch die echte
     GA4-Property-ID ersetzen und die Angaben in der Datenschutzerklärung ergänzen. */
  var GA_MEASUREMENT_ID = 'G-XXXXXXXXXX';

  function loadAnalytics(){
    if(document.getElementById('gaScript')) return;
    var s = document.createElement('script');
    s.id = 'gaScript';
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_MEASUREMENT_ID;
    document.head.appendChild(s);
    window.dataLayer = window.dataLayer || [];
    function gtag(){ window.dataLayer.push(arguments); }
    window.gtag = gtag;
    gtag('js', new Date());
    gtag('config', GA_MEASUREMENT_ID, { anonymize_ip: true });
  }

  (function(){
    var banner = document.getElementById('cookieBanner');
    var acceptBtn = document.getElementById('cookieAccept');
    var declineBtn = document.getElementById('cookieDecline');
    var settingsLink = document.getElementById('cookieSettingsLink');
    if(!banner) return;

    function getConsent(){
      try{ return localStorage.getItem('elconCookieConsent'); }catch(err){ return null; }
    }
    function setConsent(value){
      try{ localStorage.setItem('elconCookieConsent', value); }catch(err){}
    }
    function showBanner(){ banner.hidden = false; }
    function hideBanner(){ banner.hidden = true; }

    var consent = getConsent();
    if(consent === 'accepted'){ loadAnalytics(); }
    else if(consent !== 'declined'){ showBanner(); }

    if(acceptBtn) acceptBtn.addEventListener('click', function(){
      setConsent('accepted');
      loadAnalytics();
      hideBanner();
    });
    if(declineBtn) declineBtn.addEventListener('click', function(){
      setConsent('declined');
      hideBanner();
    });
    if(settingsLink) settingsLink.addEventListener('click', function(e){
      e.preventDefault();
      showBanner();
    });
  })();

  document.getElementById('requestForm').addEventListener('submit', function(e){
    e.preventDefault();
    var f = e.target;
    var subject = encodeURIComponent('Projektanfrage: ' + (f.topic.value || 'ELCON'));
    var body = encodeURIComponent(
      'Name: ' + f.name.value + '\n' +
      'E-Mail: ' + f.email.value + '\n' +
      'Leistungsbereich: ' + f.topic.value + '\n\n' +
      f.message.value
    );
    window.location.href = 'mailto:info@elcon-led.com?subject=' + subject + '&body=' + body;
  });

  // close mobile menu after a link is clicked
  document.querySelectorAll('nav.primary a').forEach(function(a){
    a.addEventListener('click', function(){
      var mt = document.getElementById('menuToggle');
      if(mt) mt.checked = false;
    });
  });

  // Zwei-Seiten-Router: "Projekte" ist ein eigener Seitenbereich, über die Hauptnavigation erreichbar
  function setPage(name){
    document.querySelectorAll('.page-panel').forEach(function(p){
      p.hidden = !p.classList.contains('page-' + name);
    });
    document.querySelectorAll('[data-page-link]').forEach(function(a){
      a.classList.toggle('is-active', a.dataset.pageLink === name);
    });
    document.title = name === 'projekte'
      ? 'Projekte & Referenzen — ELCON Connected Building Engineering'
      : name === 'unternehmen'
      ? 'Unternehmen — ELCON Connected Building Engineering'
      : 'ELCON Connected Building Engineering — Generalunternehmer für technische Gebäudeausrüstung';
  }

  var PROJEKTE_ANCHORS = ['projekte', 'generalunternehmer', 'refVerzeichnis', 'kundenfeedback'];
  var UNTERNEHMEN_ANCHORS = ['unternehmen', 'unternehmenPage'];

  function routeFromHash(){
    var hash = (location.hash || '').replace('#','');
    if(PROJEKTE_ANCHORS.indexOf(hash) !== -1){
      setPage('projekte');
      if(hash === 'projekte'){
        window.scrollTo(0,0);
      } else {
        var subEl = document.getElementById(hash);
        if(subEl){ requestAnimationFrame(function(){ subEl.scrollIntoView({behavior:'smooth', block:'start'}); }); }
      }
    } else if(UNTERNEHMEN_ANCHORS.indexOf(hash) !== -1){
      setPage('unternehmen');
      window.scrollTo(0,0);
    } else {
      setPage('home');
      var el = hash ? document.getElementById(hash) : null;
      if(el){ requestAnimationFrame(function(){ el.scrollIntoView(); }); }
      else { window.scrollTo(0,0); }
    }
  }

  document.querySelectorAll('[data-page-link]').forEach(function(a){
    a.addEventListener('click', function(e){
      e.preventDefault();
      var href = a.getAttribute('href');
      var newHash = (href && href !== '#') ? href : (a.dataset.pageLink === 'home' ? '#' : '#' + a.dataset.pageLink);
      if(location.hash !== newHash){
        history.pushState(null, '', newHash);
      }
      routeFromHash();
    });
  });

  window.addEventListener('hashchange', routeFromHash);
  routeFromHash();

  /* Testimonial carousel + lightbox */
  (function(){
    var track = document.getElementById('tcTrack');
    var prevBtn = document.getElementById('tcPrev');
    var nextBtn = document.getElementById('tcNext');
    if(!track) return;

    var thumbs = Array.prototype.slice.call(track.querySelectorAll('.tc-thumb'));
    var lightbox = document.getElementById('tcLightbox');
    var lbImg = document.getElementById('tcLbImg');
    var lbCaption = document.getElementById('tcLbCaption');
    var lbClose = document.getElementById('tcLbClose');
    var lbPrev = document.getElementById('tcLbPrev');
    var lbNext = document.getElementById('tcLbNext');
    var currentIndex = 0;
    var lastFocused = null;

    function slideStep(){
      var slide = track.querySelector('.tc-slide');
      if(!slide) return 200;
      var style = getComputedStyle(track);
      var gap = parseFloat(style.columnGap || style.gap || 0) || 0;
      return slide.getBoundingClientRect().width + gap;
    }
    if(prevBtn) prevBtn.addEventListener('click', function(){ track.scrollBy({left:-slideStep()*2, behavior:'smooth'}); });
    if(nextBtn) nextBtn.addEventListener('click', function(){ track.scrollBy({left:slideStep()*2, behavior:'smooth'}); });

    function openLightbox(index){
      currentIndex = (index + thumbs.length) % thumbs.length;
      var t = thumbs[currentIndex];
      lbImg.src = t.dataset.full;
      lbImg.alt = t.querySelector('img').alt;
      lbCaption.innerHTML = '<strong>' + t.dataset.sender + '</strong><span>' + t.dataset.date + '</span>';
      lastFocused = document.activeElement;
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
      lbClose.focus();
    }
    function closeLightbox(){
      lightbox.hidden = true;
      document.body.style.overflow = '';
      if(lastFocused && lastFocused.focus) lastFocused.focus();
    }

    thumbs.forEach(function(t, i){
      t.addEventListener('click', function(){ openLightbox(i); });
    });
    lbClose.addEventListener('click', closeLightbox);
    lbPrev.addEventListener('click', function(){ openLightbox(currentIndex - 1); });
    lbNext.addEventListener('click', function(){ openLightbox(currentIndex + 1); });
    lightbox.addEventListener('click', function(e){ if(e.target === lightbox) closeLightbox(); });
    document.addEventListener('keydown', function(e){
      if(lightbox.hidden) return;
      if(e.key === 'Escape') closeLightbox();
      else if(e.key === 'ArrowLeft') openLightbox(currentIndex - 1);
      else if(e.key === 'ArrowRight') openLightbox(currentIndex + 1);
    });
  })();

</script>
