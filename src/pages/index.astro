---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import { asset } from '../lib/assets';
import Bildhinweis from '../components/Bildhinweis.astro';
import { company } from '../config';

/* Die Gewerke stehen ausführlich auf /leistungen/. Hier nur die Namen als
   Anreißer — derselbe Wortlaut wie dort, damit nichts auseinanderläuft. */
const gewerke = [
  'Elektrotechnik',
  'Heizung, Klima, Lüftung, Sanitär',
  'Kommunikationstechnik',
  'Beleuchtungstechnik',
  'Netzwerktechnik & IT',
  'MSR- & Gebäudeautomation',
  'Brandschutz & Sicherheitstechnik',
  'Projektmanagement & Consulting',
];
---

<BaseLayout
  title="ELCON — Generalunternehmer für technische Gebäudeausrüstung"
  description="Generalunternehmer für technische Gebäudeausrüstung: Elektro-, Heizungs-, Klima-, Lüftungs-, Sanitär- und Automatisierungstechnik aus einer Hand."
  rawTitle
>

  <section class="hero">
    <div class="wrap">
      <div>
        <p class="eyebrow eyebrow-plain">Generalunternehmer für technische Gebäudeausrüstung</p>
        <h1>Komplexe Projekte<br>aus einer Hand<br>mit 30+ Jahren Expertise.</h1>
        <p class="lead">ELCON verbindet Elektro-, Heizungs-, Klima-, Lüftungs-, Sanitär- und Automatisierungstechnik zu einem Leistungsversprechen: ein fester Ansprechpartner, in Deutschland verankert und international projekterfahren, ausgelegt auf messbare Energieeffizienz.</p>
        <div class="hero-ctas">
          <a class="cta-btn primary" href="/projekte/">Projekte ansehen</a>
          <a class="cta-btn ghost" href="/kontakt/">Projekt anfragen</a>
        </div>
      </div>
      <div class="hero-medien">
        <div class="hero-art">
          <Image src={asset("/assets/hero-building.jpg")} alt="Modernes Firmengebäude mit technischer Gebäudeausrüstung" loading="eager" fetchpriority="high" />
        </div>
        <Bildhinweis art="symbolisch" />
      </div>
    </div>
    <div class="wrap">
      <LogoMarquee />
    </div>
  </section>

  <section style="background:var(--surface-alt)">
    <div class="wrap">
      <div class="section-head" style="margin-bottom:1.8rem;">
        <p class="eyebrow">Alle Gewerke, ein Partner</p>
        <h2>Leistungen im Überblick</h2>
      </div>
      <p class="offer-lead">Unsere Kompetenz in allen Gewerken des technischen Anlagenbaus runden wir durch einen maßgeschneiderten Service in jeder Lebensphase Ihrer Immobilie ab — schlüsselfertige Gebäudeausrüstung aus einer Hand, von der ersten Planung bis zur laufenden Instandhaltung.</p>
      <div class="offer-domains" style="margin-top:1.4rem;">
        {gewerke.map((g) => <span class="offer-domain-tag">{g}</span>)}
      </div>
      <div class="hero-ctas" style="margin-top:1.8rem;">
        <a class="cta-btn primary" href="/leistungen/">Alle Leistungen ansehen</a>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head" style="margin-bottom:1.4rem;">
        <p class="eyebrow">Kontakt</p>
        <h2>Projekt anfragen</h2>
      </div>
      <p class="offer-lead">Schildern Sie uns Ihr Vorhaben — wir melden uns mit einem festen Ansprechpartner zurück.</p>
      <div class="hero-ctas" style="margin-top:1.6rem;">
        <a class="cta-btn primary" href="/kontakt/">Zum Anfrageformular</a>
        <a class="cta-btn ghost" href={`tel:${company.phoneHref}`}>{company.phone}</a>
      </div>
    </div>
  </section>

</BaseLayout>
