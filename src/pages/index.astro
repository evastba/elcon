---
import Layout from '../layouts/Layout.astro';
---

<Layout>

<a href="#main" class="skip-link">Zum Inhalt springen</a>

<header class="site">
  <div class="wrap nav-row">
    <a href="#" class="brand" data-page-link="home">
      <img class="hex-mark" src="/assets/logo-icon-v2.png" alt="ELCON Icon">
      <span class="brand-text">
        <span class="brand-word">ELCON</span>
        <span class="brand-tagline">Connected Building Engineering</span>
      </span>
    </a>

    <input type="checkbox" id="menuToggle" class="menu-toggle">
    <label for="menuToggle" class="menu-toggle-label" aria-label="Menü öffnen">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M2 5h16M2 10h16M2 15h16"/></svg>
    </label>

    <nav class="primary" aria-label="Hauptnavigation">
      <a href="#leistungen">Leistungen</a>
      <div class="nav-drop">
        <a href="#projekte" data-page-link="projekte">Projekte</a>
        <div class="nav-drop-menu">
          <a href="#generalunternehmer" data-page-link="projekte">Ausgewählte Projekte</a>
          <a href="#refVerzeichnis" data-page-link="projekte">Kundenübersicht</a>
          <a href="#kundenfeedback" data-page-link="projekte">Kundenfeedback</a>
        </div>
      </div>
      <a href="#unternehmen" data-page-link="unternehmen">Unternehmen</a>
      <a href="#kontakt">Kontakt</a>
      <div class="lang-toggle" role="group" aria-label="Sprache">
        <button type="button" aria-pressed="true" onclick="setLang('de',this)">DE</button>
        <button type="button" aria-pressed="false" onclick="setLang('en',this)">EN</button>
      </div>
    </nav>
  </div>
</header>

<main id="main">
<div class="page-panel page-home">
  <!-- HERO -->
  <section class="hero">
    <div class="wrap">
      <div>
        <p class="eyebrow eyebrow-plain">Generalunternehmer für technische Gebäudeausrüstung</p>
        <h1>Komplexe Projekte<br>aus einer Hand<br>mit 30-jähriger Expertise.</h1>
        <p class="lead">ELCON verbindet Elektro-, Heizungs-, Klima-, Lüftungs-, Sanitär- und Automatisierungstechnik zu einem Leistungsversprechen: ein fester Ansprechpartner, weltweit umgesetzt, ausgelegt auf messbare Energieeffizienz.</p>
        <div class="hero-ctas">
          <a class="cta-btn primary" href="#projekte">Projekte ansehen</a>
          <a class="cta-btn ghost" href="#kontakt">Projekt anfragen</a>
        </div>
      </div>
      <div class="hero-art">
        <img src="/assets/hero-building.jpg" alt="Modernes Firmengebäude mit technischer Gebäudeausrüstung">
        <span class="ai-badge"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l1.7 5.3L19 9l-5.3 1.7L12 16l-1.7-5.3L5 9l5.3-1.7L12 2z"/><path d="M19 14l.85 2.15L22 17l-2.15.85L19 20l-.85-2.15L16 17l2.15-.85L19 14z"/></svg>AI generated</span>
      </div>
    </div>
    <div class="wrap">
      <div class="trust-block" style="margin-bottom:1.4rem;">
        <h3>Vertrauen von Unternehmen und Institutionen</h3>
        <div class="marquee">
          <div class="marquee-track" id="marqueeTrack" aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </section>

</div>

<div class="page-panel page-projekte" hidden>
  <!-- PROJEKTE / REFERENZEN (eigener Seitenbereich, über die Hauptnavigation erreichbar) -->
  <section id="referenzen" style="padding-top:2.2rem;">
    <div class="wrap">
      <a href="#" class="subpage-back" data-page-link="home">← Zurück zur Startseite</a>
      <div class="section-head" id="generalunternehmer" style="max-width:none;">
        <p class="eyebrow">Ausgewählte Projekte</p>
        <h2>Realisierte Lösungen für unsere Kunden</h2>
        <p>Vom Automobilwerk über Hotellerie und Brauereien bis zur Botschaft: ELCON hat technische Gebäudeausrüstung für Industrie, Gewerbe und öffentliche Institutionen realisiert — von Werken in Deutschland und Polen über soziale Projekte in Ostafrika bis zu langjährigen Standorten in Russland, der Ukraine und Zentralasien. Eine Auswahl unserer Projekte aus drei Jahrzehnten:</p>
      </div>

      <div class="stat-strip" style="margin-bottom:2.6rem;">
        <div><span class="stat-num">60+</span><span class="stat-label">realisierte Projekte</span></div>
        <div><span class="stat-num">1993</span><span class="stat-label">gegründet als ELCON LED GmbH</span></div>
        <div><span class="stat-num">6</span><span class="stat-label">Gewerke aus einer Hand</span></div>
        <div><span class="stat-num">3</span><span class="stat-label">Kontinente mit Projekterfahrung</span></div>
      </div>

      <div class="filter-row" role="group" aria-label="Projekte nach Gewerk filtern">
        <button type="button" class="filter-chip is-active" data-filter="all" aria-pressed="true">Alle</button>
        <button type="button" class="filter-chip" data-filter="elektro" aria-pressed="false">Elektrotechnik</button>
        <button type="button" class="filter-chip" data-filter="hkls" aria-pressed="false">HKLS</button>
        <button type="button" class="filter-chip" data-filter="msr" aria-pressed="false">MSR &amp; Automation</button>
        <button type="button" class="filter-chip" data-filter="netzwerk" aria-pressed="false">Netzwerktechnik</button>
        <button type="button" class="filter-chip" data-filter="planung" aria-pressed="false">Planung &amp; Betrieb</button>
      </div>

      <div class="project-grid" id="projectGrid">
        <article class="project-card" data-category="elektro">
          <div class="project-art-wrap project-art-wrap--logo">
            <div class="project-logo"><div class="project-logo-chip"><img src="/assets/logos/audi.png" alt="Audi Logo"></div></div>
          </div>
          <div class="project-body">
            <h3>Audi-Werk Ingolstadt, Umbau</h3>
            <span class="project-meta">Deutschland · Elektrotechnik</span>
