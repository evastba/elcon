---
import { Image } from 'astro:assets';
import logoIcon from '../assets/logo-icon-v2.png';
import { company, analyticsEnabled } from '../config';

const links = [
  { href: '/leistungen/', label: 'Leistungen' },
  { href: '/projekte/', label: 'Projekte' },
  { href: '/unternehmen/', label: 'Unternehmen' },
  { href: '/kontakt/', label: 'Kontakt' },
];
---

<footer class="site">
  <div class="wrap footer-grid">
    <div>
      <a href="/" class="brand">
        <Image src={logoIcon} class="hex-mark" alt="ELCON Icon" />
        <span class="brand-text">
          <span class="brand-word">ELCON</span>
          <span class="brand-tagline">Connected Engineering</span>
        </span>
      </a>
      <p class="footer-firma">{company.name}</p>
      <address class="footer-adresse">
        {company.street}<br />
        {company.zip} {company.city}<br />
        {company.country}
      </address>
    </div>
    <div>
      <h4>Navigation</h4>
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="wrap footer-bottom">
    <span>© 2026 {company.name}</span>
    <nav class="footer-rechtliches" aria-label="Rechtliches">
      <a href="/impressum/">Impressum</a>
      <a href="/datenschutz/">Datenschutz</a>
      {analyticsEnabled && <a href="#" id="cookieSettingsLink">Cookie-Einstellungen</a>}
    </nav>
  </div>
</footer>
