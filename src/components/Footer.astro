---
import LogoZeichen from './LogoZeichen.astro';
import Ansprechpartner from './Ansprechpartner.astro';
import { sichtbarePartner } from '../data/partner';
import { company, analyticsEnabled, ortZeile } from '../config';
import { getLang, UI, pfad } from '../i18n/ui';

/* Erweiterte Fußzeile in vier Spalten.
 *
 * Sie soll orientieren, nicht die Sitemap wiederholen: je Spalte höchstens
 * fünf Ziele, dazu die Kontaktwege und die zentrale Handlungsaufforderung.
 * Auf schmalen Bildschirmen stapeln sich die Spalten; die Linkgruppen lassen
 * sich einklappen, damit die Fußzeile das Seitenende nicht dominiert. Die
 * rechtlichen Verweise stehen außerhalb der Klappgruppen und bleiben immer
 * sichtbar.
 *
 * Alle Kontaktdaten kommen aus src/config.ts.
 */
const lang = getLang(Astro.url);
const t = UI[lang];
const f = t.footer;

/* Der Verweis auf die Partner erscheint nur, wenn der Abschnitt auf der
   Startseite auch steht — sonst zeigte die Fußzeile auf eine Sprungmarke,
   die es nicht gibt. */
const partnerSichtbar = sichtbarePartner.length > 0;
const start = lang === 'de' ? '/' : '/en/';
const land = lang === 'de' ? company.country : company.countryEn;
---

<footer class="site">
  <div class="wrap footer-grid">
    <div class="footer-marke">
      <a href={start} class="brand">
        <span class="marke-zeile">
          <LogoZeichen class="marke-zeichen" />
          <span class="brand-word">ELCON</span>
        </span>
        {/* Die Unterzeile läuft von der linken Kante des Würfels bis unter das
            N von ELCON. Damit sie diese Breite genau füllt, steht jeder Buchstabe
            für sich und der Zwischenraum verteilt sich gleichmäßig — ein fester
            Sperrwert träfe die Breite nur zufällig. Für Vorleseprogramme ist die
            Zeile ohne Belang: Der Verweis trägt eine eigene Beschriftung. */}
        <span class="brand-tagline" aria-hidden="true">
          {'GEBÄUDETECHNIK'.split('').map((z) => <span>{z}</span>)}
        </span>
      </a>
      <p class="footer-firma">{company.name}</p>
      <address class="footer-adresse">
        {company.street}<br />
        {ortZeile}<br />
        {land}
      </address>
    </div>

    <details class="footer-gruppe" open>
      <summary><h2>{f.leistungen}</h2></summary>
      <ul>
        {f.leistungenLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </details>

    <details class="footer-gruppe" open>
      <summary><h2>{f.unternehmen}</h2></summary>
      <ul>
        {f.unternehmenLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        {partnerSichtbar && (
          <li><a href={f.partnerLink.href}>{f.partnerLink.label}</a></li>
        )}
      </ul>
    </details>

    <div class="footer-kontakt">
      <h2>{f.kontakt}</h2>
      <ul class="footer-wege">
        <li>
          <span>{f.telefon}</span>
          <a href={`tel:${company.phoneHref}`}>{company.phone}</a>
        </li>
        <li>
          <span>{f.email}</span>
          <a href={`mailto:${company.email}`}>{company.email}</a>
        </li>
        <li>
          <span>{f.whatsapp}</span>
          <a href={`https://wa.me/${company.whatsapp}`} target="_blank" rel="noopener">{f.whatsappLink}</a>
        </li>
      </ul>
      <a class="cta-btn primary footer-cta" href={pfad('/kontakt/', lang)}>{f.cta}</a>
      <Ansprechpartner stelle="footer" />
    </div>
  </div>

  <div class="wrap footer-bottom">
    <span>© 2026 {company.name}</span>
    <nav class="footer-rechtliches" aria-label={t.footerRechtliches}>
      <a href={pfad('/impressum/', lang)}>{t.impressum}</a>
      <a href={pfad('/datenschutz/', lang)}>{t.datenschutz}</a>
      {analyticsEnabled && <a href="#" id="cookieSettingsLink">{t.cookieEinstellungen}</a>}
    </nav>
  </div>
</footer>

<script>
  /* Die Linkgruppen der Fußzeile stehen im Markup offen — ohne JavaScript und
     für Suchmaschinen sind die Ziele damit sichtbar. Auf schmalen Geräten
     werden sie beim Laden zugeklappt, damit das Seitenende kurz bleibt; wer
     die Breite ändert, bekommt sie wieder aufgeklappt. */
  (function () {
    var gruppen = document.querySelectorAll('.footer-gruppe');
    if (!gruppen.length) return;
    var schmal = window.matchMedia('(max-width: 640px)');

    function anpassen(e) {
      gruppen.forEach(function (g) { g.open = !e.matches; });
    }
    anpassen(schmal);
    if (schmal.addEventListener) schmal.addEventListener('change', anpassen);
  })();
</script>
