---
import { Image } from 'astro:assets';
import logoIcon from '../assets/logo-icon-v2.png';
import { company, analyticsEnabled } from '../config';
import { getLang, UI, pfad } from '../i18n/ui';

const lang = getLang(Astro.url);
const t = UI[lang];

/* Dieselben Ziele wie in der Kopfnavigation, ohne die Untereinträge. */
const links = t.nav.map((l) => ({ href: l.href, label: l.label }));

/* Das Land steht in der Stammdatendatei auf Deutsch; in der englischen Fassung
   wäre "Deutschland" in einer sonst englischen Anschrift ein Fremdkörper. */
const land = lang === 'de' ? company.country : 'Germany';
---

<footer class="site">
  <div class="wrap footer-grid">
    <div>
      <a href={lang === 'de' ? '/' : '/en/'} class="brand">
        <Image src={logoIcon} class="hex-mark" alt="ELCON Icon" />
        <span class="brand-text">
          <span class="brand-word">ELCON</span>
          <span class="brand-tagline">Connected Engineering</span>
        </span>
      </a>
      <p class="footer-firma">{company.name}</p>
      <address class="footer-adresse">
        {company.street}<br />
        {company.zip} {company.city}<br />
        {land}
      </address>
    </div>
    <div>
      <h4>{t.footerNavTitel}</h4>
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="wrap footer-bottom">
    <span>© 2026 {company.name}</span>
    <nav class="footer-rechtliches" aria-label={t.footerRechtliches}>
      <a href={pfad('/impressum/', lang)}>{t.impressum}</a>
      <a href={pfad('/datenschutz/', lang)}>{t.datenschutz}</a>
      {analyticsEnabled && <a href="#" id="cookieSettingsLink">{t.cookieEinstellungen}</a>}
    </nav>
  </div>
</footer>
