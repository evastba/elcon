---
import { Image } from 'astro:assets';
import { asset } from '../lib/assets';
import { getLang } from '../i18n/ui';
import { STARTSEITE } from '../i18n/startseite';
import { sichtbarePartner } from '../data/partner';

/* Partnerunternehmen am Ende der Startseite.
 *
 * Gezeigt wird nur, wer in data/partner.ts freigegeben und vollständig
 * hinterlegt ist. Liegt kein solcher Eintrag vor, entfällt der Abschnitt —
 * eine Überschrift ohne Kacheln wäre schlechter als keine.
 */
const lang = getLang(Astro.url);
const t = STARTSEITE[lang].partner;

const partner = sichtbarePartner.map((p) => ({
  ...p,
  worte: (lang === 'de' ? p.stichworte : p.stichworteEn) ?? [],
  ort: (lang === 'de' ? p.sitz : p.sitzEn ?? p.sitz) ?? null,
  logoAlt: p.logo ? (lang === 'de' ? p.logo.alt : p.logo.altEn) : '',
}));
---

{partner.length > 0 && (
  <section class="partner" id="partnerunternehmen" style="background:var(--surface-alt)">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{t.eyebrow}</p>
        <h2>{t.titel}</h2>
        <p>{t.intro}</p>
      </div>

      <ul class="partner-liste">
        {partner.map((p) => (
          <li class="partner-karte">
            {p.logo && (
              <div
                class:list={['partner-logo', `partner-logo--${p.logo.hintergrund}`]}
                style={`--logo-skalierung:${p.logo.skalierung ?? 1}`}
              >
                <Image src={asset(`/assets/partner/${p.logo.datei}`)} alt={p.logoAlt} loading="lazy" />
              </div>
            )}
            <div class="partner-text">
              <h3>{p.name}</h3>
              {p.ort && <p class="partner-sitz">{`${t.sitzLabel}: ${p.ort}`}</p>}
              <ul class="partner-worte">
                {p.worte.map((w) => <li>{w}</li>)}
              </ul>
              {p.website ? (
                <a class="cta-btn umriss partner-link" href={p.website} target="_blank" rel="noopener noreferrer">
                  {t.websiteLabel}
                </a>
              ) : p.ohneWebsiteKnopf ? null : (
                /* Ohne Adresse steht die Zeile nur da, damit die Kacheln
                   gleich aufgebaut bleiben. Bewusst kein Verweis: Ein Link
                   ins Leere führte zu einer Fehlerseite, und Vorleseprogramme
                   kündigten ein Ziel an, das es nicht gibt. Trägt der Eintrag
                   ohneWebsiteKnopf, entfällt auch diese Zeile. */
                <span class="cta-btn umriss partner-link partner-link--ohne-ziel">{t.websiteLabel}</span>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
