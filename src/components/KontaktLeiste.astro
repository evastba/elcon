---
import { company } from '../config';
import { useUi } from '../i18n/ui';

/* Feste Kontaktleiste am unteren Rand — nur auf schmalen Bildschirmen.
 *
 * Im Bau wird angerufen, nicht getippt. Auf dem Telefon ist der Weg zur
 * Rufnummer sonst lang: Menü öffnen, Kontakt ansteuern, scrollen. Diese Leiste
 * hält Anruf und WhatsApp durchgängig in Reichweite des Daumens.
 *
 * Auf Desktop-Breiten bleibt sie ausgeblendet, dort stehen die Angaben ohnehin
 * in Kopf- und Fußzeile.
 */
const t = useUi(Astro.url);
---

<div class="kontaktleiste" role="group" aria-label={t.schnellkontakt}>
  <a class="kontaktleiste-btn kontaktleiste-btn--anruf" href={`tel:${company.phoneHref}`}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>
    </svg>
    <span>{t.anrufen}</span>
  </a>
  <a
    class="kontaktleiste-btn kontaktleiste-btn--whatsapp"
    href="https://wa.me/4951757716116"
    target="_blank"
    rel="noopener"
  >
    <svg viewBox="0 0 32 32" aria-hidden="true">
      <path fill="currentColor" d="M16.004 0C7.164 0 0 7.163 0 16c0 2.82.738 5.566 2.14 7.982L0 32l8.223-2.13A15.94 15.94 0 0016.004 32C24.84 32 32 24.837 32 16S24.84 0 16.004 0zm8.136 19.13c-.406-.203-2.4-1.184-2.773-1.32-.372-.136-.643-.203-.914.204-.27.406-1.05 1.32-1.287 1.59-.237.27-.474.305-.88.102-.406-.204-1.715-.632-3.267-2.017-1.208-1.077-2.024-2.407-2.261-2.813-.237-.406-.025-.626.178-.828.183-.183.406-.474.61-.712.202-.237.27-.406.405-.677.135-.27.068-.508-.034-.712-.102-.203-.914-2.202-1.252-3.016-.33-.792-.665-.685-.914-.698-.237-.012-.508-.014-.78-.014-.27 0-.71.101-1.082.508-.372.406-1.42 1.388-1.42 3.387 0 1.998 1.454 3.929 1.657 4.2.203.27 2.862 4.37 6.933 6.13.969.418 1.724.668 2.313.855.972.31 1.856.266 2.556.161.78-.116 2.4-.981 2.738-1.928.338-.948.338-1.76.237-1.929-.101-.169-.372-.27-.778-.474z"/>
    </svg>
    <span>WhatsApp</span>
  </a>
</div>
