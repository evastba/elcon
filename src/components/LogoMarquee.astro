---
import { Image } from 'astro:assets';
import { sichtbareLogos } from '../data/referenzen';
import { useUi } from '../i18n/ui';

/* Logo-Laufschrift der Startseite.
 *
 * Quelle ist die zentrale Referenzverwaltung: Nur Logos mit einem Status
 * ungleich 'do-not-publish' und ohne abgelehnte Freigabe laufen mit. Vorher
 * stand die Liste in einer eigenen Datei — Nord Stream blieb dort stehen,
 * obwohl es in der Referenzverwaltung längst entfernt war.
 *
 * Serverseitig gerendert laufen die Logos durch die Bildpipeline (WebP, Maße
 * im Markup) und stehen ohne JavaScript im Dokument. Die Liste wird
 * verdoppelt, weil die CSS-Animation exakt die halbe Breite verschiebt und
 * der zweite Durchlauf die Lücke füllt. Für Vorlesesoftware ist das Band als
 * dekorativ ausgezeichnet — die Namen stehen in der Kundenübersicht.
 */
const logoModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/logos/*.{jpg,jpeg,png}',
  { eager: true },
);

const logos = sichtbareLogos
  .filter((c) => c.freigabe !== 'abgelehnt')
  .map((c) => ({ ...c, image: logoModules[`../assets/logos/${c.datei}`]?.default }))
  .filter((c) => c.image);

const doubled = [...logos, ...logos];

const t = useUi(Astro.url);

/* Steht über der Laufschrift bereits eine Überschrift — etwa die des
   Vertrauensabschnitts auf der Startseite —, bleibt die eigene weg. */
interface Props { zeigeTitel?: boolean }
const { zeigeTitel = true } = Astro.props;
---

<div class="trust-block">
  {zeigeTitel && <h3>{t.marqueeTitel}</h3>}
  <div class="marquee">
    <div class="marquee-track" aria-hidden="true">
      {doubled.map((c) => (
        <span class:list={['marquee-logo', c.gross && 'marquee-logo--lg']}>
          <Image src={c.image!} alt={c.name} loading="lazy" decoding="async" />
        </span>
      ))}
    </div>
  </div>
</div>
