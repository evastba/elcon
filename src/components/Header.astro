---
import LogoZeichen from './LogoZeichen.astro';
import { getLang, UI, LANGS, anderePfad, pfad } from '../i18n/ui';

/* Die Navigation markiert die aktive Seite serverseitig. Astro.url.pathname
   endet je nach Aufruf mit oder ohne Schrägstrich, deshalb wird normalisiert. */
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

const lang = getLang(Astro.url);
const t = UI[lang];
const links = t.nav;

/* Sprachumschalter: dieselbe Seite in jeder verfügbaren Sprache. Die Liste
   kommt aus LANGS, damit eine neue Sprache nur dort einzutragen ist und hier
   nichts vergessen werden kann. */
const sprachen = LANGS.map((l) => ({
  lang: l,
  href: anderePfad(Astro.url.pathname, l),
  kuerzel: UI[l].sprachkuerzel,
  name: UI[l].sprachname,
  htmlLang: UI[l].htmlLang,
}));

const isActive = (href: string) => path === href.replace(/\/+$/, '');
---

<header class="site">
  <div class="wrap nav-row">
    {/* Drei Fassungen der Marke nebeneinander, ausschließlich im Kopfbereich
        und ausschließlich zur Ansicht. Nur die erste ist ein Verweis; die
        beiden Vergleichsfassungen sind für Vorleseprogramme ausgeblendet, weil
        drei Marken nebeneinander dort nur verwirrend wären. */}
    <div class="marken-vergleich">
      <a href={pfad('/', lang)} class="brand" aria-label={t.zurStartseite}>
        <span class="marke-zeile">
          <LogoZeichen class="marke-zeichen" />
          <span class="brand-word">ELCON</span>
        </span>
        {/* Die Unterzeile läuft von der linken Kante des Würfels bis unter das
            N von ELCON. Damit sie diese Breite genau füllt, steht jeder
            Buchstabe für sich und der Zwischenraum verteilt sich gleichmäßig —
            ein fester Sperrwert träfe die Breite nur zufällig. */}
        <span class="brand-tagline" aria-hidden="true">
          {'GEBÄUDETECHNIK'.split('').map((z) => <span>{z}</span>)}
        </span>
      </a>

      {/* Zweite Fassung: Der Würfel reicht über beide Zeilen, die Unterzeile
          steht im Orange des Würfels und füllt genau die Breite von ELCON. */}
      <span class="marke-b" aria-hidden="true">
        <LogoZeichen class="marke-b-zeichen" />
        <span class="marke-b-text">
          <span class="marke-b-wort">ELCON</span>
          <span class="marke-b-unterzeile">
            {'GEBÄUDETECHNIK'.split('').map((z) => <span>{z}</span>)}
          </span>
        </span>
      </span>

      {/* Dritte Fassung: wie die erste, nur steht die Unterzeile im Orange des
          Würfels statt in Navy. */}
      <span class="brand marke-c" aria-hidden="true">
        <span class="marke-zeile">
          <LogoZeichen class="marke-zeichen" />
          <span class="brand-word">ELCON</span>
        </span>
        <span class="brand-tagline">
          {'GEBÄUDETECHNIK'.split('').map((z) => <span>{z}</span>)}
        </span>
      </span>
    </div>

    <input type="checkbox" id="menuToggle" class="menu-toggle">
    <label for="menuToggle" class="menu-toggle-label" aria-label={t.menueOeffnen}>
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M2 5h16M2 10h16M2 15h16"/></svg>
    </label>

    <nav class="primary" aria-label={t.navLabel}>
      {links.map((link) => link.sub ? (
        <div class="nav-drop">
          <a
            href={link.href}
            class:list={{ 'is-active': isActive(link.href) }}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >{link.label}</a>
          <div class="nav-drop-menu">
            {link.sub.map((s) => <a href={s.href}>{s.label}</a>)}
          </div>
        </div>
      ) : (
        <a
          href={link.href}
          class:list={{ 'is-active': isActive(link.href) }}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >{link.label}</a>
      ))}
      <div class="lang-toggle" role="group" aria-label={t.sprachname}>
        {sprachen.map((s) => (
          <a
            href={s.href}
            hreflang={s.htmlLang}
            lang={s.htmlLang}
            title={s.name}
            class:list={{ 'is-active': lang === s.lang }}
            aria-current={lang === s.lang ? 'true' : undefined}
          >{s.kuerzel}</a>
        ))}
      </div>
    </nav>
  </div>
</header>

<script>
  /* Mobiles Menü nach einem Klick schließen — beim Wechsel auf eine andere
     Seite lädt das Dokument zwar neu, bei Ankerlinks innerhalb der Seite
     bliebe das Panel sonst offen stehen. */
  document.querySelectorAll('nav.primary a').forEach((a) => {
    a.addEventListener('click', () => {
      const mt = document.getElementById('menuToggle') as HTMLInputElement | null;
      if (mt) mt.checked = false;
    });
  });
</script>
