---
import { Image } from 'astro:assets';
import logoIcon from '../assets/logo-icon-v2.png';
import { getLang, UI, anderePfad } from '../i18n/ui';

/* Die Navigation markiert die aktive Seite serverseitig. Astro.url.pathname
   endet je nach Aufruf mit oder ohne Schrägstrich, deshalb wird normalisiert. */
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

const lang = getLang(Astro.url);
const t = UI[lang];
const links = t.nav;

/* Ziel des Sprachumschalters: dieselbe Seite in der anderen Sprache. Früher
   stand hier ein Schalter, der nur eine Hinweismeldung auslöste — jetzt gibt es
   beide Fassungen, also führt er auch dorthin. */
const zielDe = anderePfad(Astro.url.pathname, 'de');
const zielEn = anderePfad(Astro.url.pathname, 'en');

const isActive = (href: string) => path === href.replace(/\/+$/, '');
---

<header class="site">
  <div class="wrap nav-row">
    <a href={lang === 'de' ? '/' : '/en/'} class="brand" aria-label={t.zurStartseite}>
      <Image src={logoIcon} class="hex-mark" alt="ELCON Icon" loading="eager" />
      <span class="brand-text">
        <span class="brand-word">ELCON</span>
        <span class="brand-tagline">Connected Engineering</span>
      </span>
    </a>

    <input type="checkbox" id="menuToggle" class="menu-toggle">
    <label for="menuToggle" class="menu-toggle-label" aria-label={t.menueOeffnen}>
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M2 5h16M2 10h16M2 15h16"/></svg>
    </label>

    <nav class="primary" aria-label={t.navLabel}>
      {links.map((link) => link.sub ? (
        <div class="nav-drop">
          <a
            href={link.href}
            class:list={{ 'is-active': isActive(link.href) }}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >{link.label}</a>
          <div class="nav-drop-menu">
            {link.sub.map((s) => <a href={s.href}>{s.label}</a>)}
          </div>
        </div>
      ) : (
        <a
          href={link.href}
          class:list={{ 'is-active': isActive(link.href) }}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >{link.label}</a>
      ))}
      <div class="lang-toggle" role="group" aria-label={lang === 'de' ? 'Sprache' : 'Language'}>
        <a
          href={zielDe}
          hreflang="de"
          lang="de"
          class:list={{ 'is-active': lang === 'de' }}
          aria-current={lang === 'de' ? 'true' : undefined}
        >DE</a>
        <a
          href={zielEn}
          hreflang="en"
          lang="en"
          class:list={{ 'is-active': lang === 'en' }}
          aria-current={lang === 'en' ? 'true' : undefined}
        >EN</a>
      </div>
    </nav>
  </div>
</header>

<script>
  /* Mobiles Menü nach einem Klick schließen — beim Wechsel auf eine andere
     Seite lädt das Dokument zwar neu, bei Ankerlinks innerhalb der Seite
     bliebe das Panel sonst offen stehen. */
  document.querySelectorAll('nav.primary a').forEach((a) => {
    a.addEventListener('click', () => {
      const mt = document.getElementById('menuToggle') as HTMLInputElement | null;
      if (mt) mt.checked = false;
    });
  });
</script>
