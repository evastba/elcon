# Ausgaben, die auf Zuruf erzeugt werden und nicht in die Versionierung
# gehoeren — ein Website-PDF wiegt mehrere Megabyte und veraltet mit jeder
# Aenderung.
ELCON-Website.pdf

# Build-Ausgabe
dist/
.output/
.vercel/
.netlify/

# Astro
.astro/

# Abhängigkeiten
node_modules/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Umgebungsvariablen
.env
.env.production
.env.*.local

# Betriebssystem
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# macOS-Dubletten. Auf diesem Rechner legt ein Dienst Kopien mit dem Zusatz
# " 2" an (" 3" usw.). Sie sind byteweise identisch, würden aber mitversioniert
# und bei jedem Build zusätzlich verarbeitet.
* [0-9].*
